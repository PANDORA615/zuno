[Unit]
Description=Verified Zuno SQLite backup
After=zuno.service

[Service]
Type=oneshot
User=zuno-app
Group=zuno-app
WorkingDirectory=/opt/zuno/current
EnvironmentFile=/etc/zuno.env
ExecStart=/usr/local/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zuno
